---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="YerosCare - Speak with a Doctor Online" description="Connect with trusted doctors online.">
  <Header audience="home" />

  <main class="home-main">
    <!-- Premium Hero -->
    <section class="hero">
      <div class="hero-bg-effects">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
      </div>
      
      <div class="container hero-content">
        <div class="premium-badge">✨ The future of healthcare is here</div>
        <h1 class="hero-title">Healthcare that fits <span class="text-gradient">your life.</span></h1>
        <p class="hero-subtitle">
          Skip the waiting room. Connect with trusted doctors in Nigeria for video, voice, chat, or home consultations.
        </p>
      </div>
    </section>

    <!-- Premium Split Cards -->
    <section class="split-section">
      <div class="container split-grid">
        
        <!-- Patient Card -->
        <a href="/patients" class="split-card glass-card patient-theme">
          <div class="card-visual">
            <div class="icon-circle">👤</div>
          </div>
          <div class="card-content">
            <h2>I am a Patient</h2>
            <p>Speak with a doctor online. Explore consultations that fit your schedule, wherever you are.</p>
            <div class="card-action">
              <span>Find a Doctor</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

        <!-- Doctor Card -->
        <a href="/doctors" class="split-card glass-card doctor-theme">
          <div class="card-visual">
            <div class="icon-circle">🩺</div>
          </div>
          <div class="card-content">
            <h2>I am a Doctor</h2>
            <p>Turn suitable enquiries into paid consultations. Join YerosCare and grow your practice.</p>
            <div class="card-action">
              <span>Apply to Join</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main { position: relative; overflow: hidden; }

  /* Premium Hero */
  .hero {
    position: relative;
    padding: 6rem 0 4rem 0;
    text-align: center;
    background: var(--color-bg-base);
  }

  /* Background Glow Orbs */
  .hero-bg-effects { position: absolute; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden; z-index: 0; pointer-events: none; }
  .glow-orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.5; }
  .orb-1 { width: 400px; height: 400px; background: #DDD6FE; top: -100px; left: -100px; }
  .orb-2 { width: 300px; height: 300px; background: #E9D5FF; bottom: 0; right: -50px; }

  .hero-content { position: relative; z-index: 1; max-width: 800px; }
  
  .premium-badge {
    display: inline-block; background: white; border: 1px solid #E5E7EB;
    padding: 0.5rem 1rem; border-radius: 9999px; font-weight: 600; font-size: 0.875rem;
    color: var(--color-primary-dark); box-shadow: var(--shadow-sm); margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3rem; font-weight: 800; color: var(--color-text-main); margin-bottom: 1.5rem;
  }
  
  .text-gradient {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }

  .hero-subtitle { font-size: 1.25rem; color: var(--color-text-muted); max-width: 600px; margin: 0 auto; }

  /* Split Section */
  .split-section { padding: 2rem 0 6rem 0; position: relative; z-index: 1; }
  .split-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; max-width: 900px; }

  /* Premium Cards */
  .split-card {
    display: flex; flex-direction: column; border-radius: 2rem; overflow: hidden;
    text-decoration: none; color: inherit; transition: all 0.4s ease; padding: 2.5rem;
    position: relative;
  }

  .split-card:hover { transform: translateY(-8px); }

  .patient-theme:hover { box-shadow: 0 20px 40px -10px rgba(91, 33, 182, 0.2); border-color: #C4B5FD; }
  .doctor-theme:hover { box-shadow: 0 20px 40px -10px rgba(2, 132, 199, 0.2); border-color: #BAE6FD; }

  .card-visual { margin-bottom: 2rem; }
  .icon-circle {
    width: 64px; height: 64px; border-radius: 1rem; display: flex; align-items: center; justify-content: center;
    font-size: 2rem; background: white; box-shadow: var(--shadow-md);
  }

  .card-content h2 { font-size: 1.75rem; margin-bottom: 0.75rem; color: var(--color-text-main); }
  .card-content p { color: var(--color-text-muted); margin-bottom: 2rem; font-size: 1.05rem; }

  .card-action {
    display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-family: var(--font-heading);
    color: var(--color-primary); font-size: 1.1rem; transition: gap 0.3s ease;
  }
  .doctor-theme .card-action { color: #0284C7; }
  .split-card:hover .card-action { gap: 1rem; }

  @media (min-width: 768px) {
    .hero-title { font-size: 4rem; }
    .split-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  }
</style>
