---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="YerosCare - Speak with a Doctor Online" description="Connect with trusted doctors online.">
  <Header audience="home" />

  <main class="home-main">
    <!-- Premium Hero with Background Image -->
    <section class="hero">
      <div class="container hero-content">
        <div class="premium-badge">✨ The future of healthcare is here</div>
        
        <h1 class="hero-title">
          Healthcare that fits <br class="desktop-break" /> <span class="text-gradient">your life.</span>
        </h1>
        
        <p class="hero-subtitle">
          YerosCare connects patients with trusted doctors for online consultations, and helps doctors turn enquiries into paid consultations.
        </p>
      </div>
    </section>

    <!-- Premium Split Cards -->
    <section class="split-section">
      <div class="container split-grid">
        
        <!-- Patient Card -->
        <a href="/patients" class="split-card glass-card patient-theme">
          <div class="card-visual">
            <div class="icon-circle">👤</div>
          </div>
          <div class="card-content">
            <h2>I am a Patient</h2>
            <p>Speak with a doctor online. Explore consultations that fit your schedule, wherever you are.</p>
            <div class="card-action">
              <span>Find a Doctor</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

        <!-- Doctor Card -->
        <a href="/doctors" class="split-card glass-card doctor-theme">
          <div class="card-visual">
            <div class="icon-circle">🩺</div>
          </div>
          <div class="card-content">
            <h2>I am a Doctor</h2>
            <p>Turn suitable enquiries into paid consultations. Join YerosCare and grow your practice.</p>
            <div class="card-action">
              <span>Apply to Join</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        </a>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .home-main { position: relative; overflow: hidden; background-color: var(--color-bg-base); }

  /* Premium Hero with Image Background */
  .hero {
    position: relative;
    padding: 8rem 0 6rem 0;
    text-align: center;
    
    /* THE BACKGROUND IMAGE */
    /* Replace this URL with your own image, e.g., url('/images/hero-bg.jpg') */
    background-image: url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?q=80&w=2070&auto=format&fit=crop'); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    /* Optional: Adds a parallax effect on desktop */
    background-attachment: fixed; 
  }

  /* The Dark Purple Overlay to make text readable */
  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    /* Gradient from deep purple to your primary brand color */
    background: linear-gradient(135deg, rgba(46, 16, 101, 0.9), rgba(91, 33, 182, 0.7));
    z-index: 1;
  }

  .hero-content { 
    position: relative; 
    z-index: 2; /* Keeps text above the overlay */
    max-width: 850px; 
  }
  
  .premium-badge {
    display: inline-block; 
    background: rgba(255, 255, 255, 0.15); 
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.5rem 1.25rem; 
    border-radius: 9999px; 
    font-weight: 600; 
    font-size: 0.875rem;
    color: white; 
    backdrop-filter: blur(10px);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3rem; 
    font-weight: 800; 
    color: white; 
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }
  
  /* Light gradient for the highlighted text */
  .text-gradient {
    background: linear-gradient(135deg, #E9D5FF, #C4B5FD);
    -webkit-background-clip: text; 
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle { 
    font-size: 1.25rem; 
    color: #E9D5FF; /* Light purple text */
    max-width: 700px; 
    margin: 0 auto; 
    line-height: 1.6;
  }

  /* Split Section */
  .split-section { padding: 4rem 0 6rem 0; position: relative; z-index: 1; }
  .split-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; max-width: 900px; }

  /* Premium Cards (Glassmorphism) */
  .split-card {
    display: flex; flex-direction: column; border-radius: 2rem; overflow: hidden;
    text-decoration: none; color: inherit; transition: all 0.4s ease; padding: 2.5rem;
    position: relative;
  }

  .split-card:hover { transform: translateY(-8px); }

  .patient-theme:hover { box-shadow: 0 20px 40px -10px rgba(91, 33, 182, 0.2); border-color: #C4B5FD; }
  .doctor-theme:hover { box-shadow: 0 20px 40px -10px rgba(2, 132, 199, 0.2); border-color: #BAE6FD; }

  .card-visual { margin-bottom: 2rem; }
  .icon-circle {
    width: 64px; height: 64px; border-radius: 1rem; display: flex; align-items: center; justify-content: center;
    font-size: 2rem; background: white; box-shadow: var(--shadow-md);
  }

  .card-content h2 { font-size: 1.75rem; margin-bottom: 0.75rem; color: var(--color-text-main); }
  .card-content p { color: var(--color-text-muted); margin-bottom: 2rem; font-size: 1.05rem; }

  .card-action {
    display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-family: var(--font-heading);
    color: var(--color-primary); font-size: 1.1rem; transition: gap 0.3s ease;
  }
  .doctor-theme .card-action { color: #0284C7; }
  .split-card:hover .card-action { gap: 1rem; }

  /* Responsive */
  @media (min-width: 768px) {
    .hero { padding: 10rem 0 8rem 0; }
    .hero-title { font-size: 4.5rem; }
    .split-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .desktop-break { display: block; }
  }
</style>
