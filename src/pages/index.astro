---
import Layout from '../layouts/Layout.astro';

const stores = [
  { href: __APPSTORE_URL__, line: 'Download on the', name: 'App Store' },
  { href: __PLAY_URL__, line: 'Get it on', name: 'Google Play' },
];
---

<Layout
  title="YerosCare: see a doctor online, around your day"
  description="Answer a few guided questions, get pointed to a suitable doctor or specialist, and book a video, voice, chat or home-service consultation in the YerosCare app."
  page="patients"
>
  <!-- ═════ AWARENESS: why does this matter to me? ═════ -->

  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>See a doctor online, around your day.</h1>
        <p class="lede">
          Answer a few guided questions, get pointed to a suitable doctor or specialist, and book a
          time that works for you.
        </p>
        <div class="hero-actions">
          <div class="stores">
            {
              stores.map((s) => (
                <a class="store" href={s.href}>
                  <span>{s.line}</span>
                  <strong>{s.name}</strong>
                </a>
              ))
            }
          </div>
          <a class="btn btn-outline" href="#how-it-works">How it works</a>
        </div>
        <p class="hero-note"><b>Every doctor's MDCN licence is verified</b> before they appear.</p>
      </div>

      <!--
        This phone is an illustration. When you have real screenshots, save one as
        public/phone-patient.webp and replace the whole <div class="phone-wrap"> block with:
        <img src="/phone-patient.webp" alt="..." width="560" height="1100" />
      -->
      <div class="phone-wrap">
        <div class="phone" role="img" aria-label="Illustration of a YerosCare doctor screen showing services and available times">
          <div class="phone-screen" aria-hidden="true">
            <div class="phone-row">
              <span class="avatar"></span>
              <span class="skel-lines"><span class="skel"></span><span class="skel" style="width: 60%"></span></span>
            </div>
            <p class="phone-label">Services</p>
            <ul class="chips">
              <li class="chip">Video</li>
              <li class="chip">Voice</li>
              <li class="chip">Chat</li>
              <li class="chip">Home service</li>
            </ul>
            <p class="phone-label">Available times</p>
            <ul class="chips">
              <li class="slot">Mon 9:00</li>
              <li class="slot">Wed 14:30</li>
              <li class="slot">Fri 17:00</li>
            </ul>
            <span class="phone-btn">Book</span>
          </div>
        </div>
        <p class="caption">Illustrative screen</p>
      </div>
    </div>
  </section>

  <div class="wrap benefits">
    <div class="benefit">
      <h3>Less travel, less disruption</h3>
      <p>Consult by video, voice or chat from wherever you are.</p>
    </div>
    <div class="benefit">
      <h3>The right doctor, faster</h3>
      <p>Guided questions point you to a suitable doctor or specialist.</p>
    </div>
    <div class="benefit">
      <h3>Your records stay with you</h3>
      <p>Read your consultation notes and download your prescriptions in the app.</p>
    </div>
  </div>

  <!-- ═════ CONSIDERATION: would this work for me? ═════ -->

  <section class="section section-tint" id="how-it-works">
    <div class="wrap split">
      <div>
        <h2>How it works</h2>
        <p>From signing in to your prescription, everything happens in the app.</p>
      </div>
      <ol class="steps">
        <li>
          <div>
            <h3>Sign in with your email</h3>
            <p>Use your email address to create your account.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Answer a few guided questions</h3>
            <p>
              The guided triage helps point you to a suitable doctor or specialist. It does not give
              a diagnosis.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>Choose a doctor, a service and a time</h3>
            <p>
              See each doctor's services, fees and available times before you book. You pay in the
              app.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>Consult, then keep your records</h3>
            <p>Your consultation notes and prescriptions are in the app whenever you need them.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="doctors">
    <div class="wrap split">
      <div>
        <h2>Licensed doctors, verified before they appear</h2>
      </div>
      <div>
        <p>
          Every doctor gives their professional details and MDCN licence number. We verify the
          licence before patients can see their profile.
        </p>
        <ul class="ticks">
          <li>Doctors choose their own working days and hours, so the availability you see is theirs.</li>
          <li>Each doctor sets their own fee for every service, and you see it before you pay.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>Choose how you want to talk</h2>
      </div>
      <div class="tiles">
        <div class="tile">
          <h3>Video</h3>
          <p>See and speak to your doctor from your phone.</p>
        </div>
        <div class="tile">
          <h3>Voice</h3>
          <p>A phone call with your doctor, inside the app.</p>
        </div>
        <div class="tile">
          <h3>Chat</h3>
          <p>Write to your doctor instead of calling.</p>
        </div>
        <div class="tile">
          <h3>Home service</h3>
          <p>
            Some doctors visit you at home. They list the areas they cover, so you can check before
            you book.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="records">
    <div class="wrap split split-even">
      <div>
        <h2>Your notes and prescriptions stay with you</h2>
        <p>
          After a consultation, read your doctor's notes in the app. Download your prescriptions and
          share them with a pharmacy.
        </p>
      </div>
      <div>
        <div class="doc-card" role="img" aria-label="Illustration of a consultation note and prescription with download and share buttons">
          <h3>Consultation notes</h3>
          <span class="skel"></span>
          <span class="skel"></span>
          <h3>Prescription</h3>
          <div class="doc-actions">
            <span class="chip">Download</span>
            <span class="chip">Share with pharmacy</span>
          </div>
        </div>
        <p class="caption">Illustrative screen</p>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="safety">
    <div class="wrap">
      <div class="notice">
        <h2>Is online care right for you?</h2>
        <p>
          Online consultations suit many everyday concerns and follow-up conversations. They cannot
          replace an in-person examination when you need one, and they are not for emergencies. If it
          is urgent, go to the nearest hospital.
        </p>
        <p>
          Our guided questions help you choose a doctor. They do not replace a doctor's advice.
        </p>
      </div>
    </div>
  </section>

  <!-- ═════ DECISION: what happens next? ═════ -->

  <section class="section" id="faq">
    <div class="wrap split">
      <div>
        <h2>Questions people ask</h2>
      </div>
      <div class="faq">
        <details>
          <summary>How do I pay?</summary>
          <p>You pay in the app when you book.</p>
        </details>
        <details>
          <summary>Who sets the price?</summary>
          <p>
            Each doctor sets their own fees. You see the fee for every service before you book.
          </p>
        </details>
        <details>
          <summary>Can I cancel?</summary>
          <p>
            You can request a cancellation for a service you have paid for that has not taken place.
            We tell the doctor, who is expected to respond within 48 hours. If they do not respond,
            your refund goes ahead.
          </p>
        </details>
        <details>
          <summary>Are the doctors licensed?</summary>
          <p>
            Yes. We verify each doctor's MDCN licence before their profile becomes visible to
            patients.
          </p>
        </details>
        <details>
          <summary>Does the guided triage diagnose me?</summary>
          <p>
            No. It helps point you to a suitable doctor or specialist. Your doctor gives the advice.
          </p>
        </details>
        <details>
          <summary>What if it is an emergency?</summary>
          <p>YerosCare is not for emergencies. Go to the nearest hospital.</p>
        </details>
        <details>
          <summary>Which phones does it work on?</summary>
          <p>YerosCare is available for iPhone and Android.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section section-dark on-dark" id="get">
    <div class="wrap">
      <h2>Ready to see a doctor?</h2>
      <p class="lede">
        Download YerosCare, sign in with your email and answer a few guided questions. We will point
        you toward a suitable doctor.
      </p>
      <div class="stores">
        {
          stores.map((s) => (
            <a class="store" href={s.href}>
              <span>{s.line}</span>
              <strong>{s.name}</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
