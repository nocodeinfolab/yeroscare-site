---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="YerosCare - Speak with a Doctor Online" description="Connect with trusted doctors online.">
  <Header audience="home" />

  <main>
    <!-- PREMIUM HERO -->
    <section class="hero">
      <!-- Background Effects -->
      <div class="hero-grid"></div>
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>

      <div class="container hero-layout">

        <!-- Text Content (Left Side) -->
        <div class="hero-content">
          <div class="hero-eyebrow reveal">
            <span class="dot"></span> Now available in Nigeria
          </div>

          <h1 class="hero-title reveal reveal-delay-1">
            Healthcare that fits<br><em>your life.</em>
          </h1>

          <p class="hero-body reveal reveal-delay-2">
            YerosCare connects patients with trusted doctors for online consultations,
            and helps doctors turn enquiries into paid consultations.
          </p>
        </div>

        <!-- Phone Mockup (built in HTML/CSS, no image file) -->
        <div class="hero-image-wrapper reveal reveal-delay-3">
          <div class="image-backglow"></div>

          <div class="phone" role="img" aria-label="The YerosCare app showing Stephen Umana's doctor profile with video and voice consultation options">
            <span class="side-btn sb-1"></span>
            <span class="side-btn sb-2"></span>
            <span class="side-btn sb-3"></span>
            <span class="side-btn sb-4"></span>

            <div class="phone-frame">
              <div class="phone-bezel">
                <div class="screen" aria-hidden="true">

                  <!-- Header -->
                  <div class="app-header">
                    <div class="island"></div>
                    <div class="status">
                      <span class="time">9:41</span>
                      <span class="status-icons">
                        <svg viewBox="0 0 20 14" width="20" height="14" fill="#fff"><rect x="0" y="9" width="3.4" height="5" rx="1"/><rect x="5.4" y="6" width="3.4" height="8" rx="1"/><rect x="10.8" y="3" width="3.4" height="11" rx="1"/><rect x="16.2" y="0" width="3.4" height="14" rx="1"/></svg>
                        <svg viewBox="0 0 20 14" width="19" height="14" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M2 5.2a11 11 0 0 1 16 0"/><path d="M5 8.4a6.6 6.6 0 0 1 10 0"/><circle cx="10" cy="11.8" r="1.2" fill="#fff" stroke="none"/></svg>
                        <svg viewBox="0 0 30 14" width="30" height="14"><rect x="0.8" y="0.8" width="25" height="12.4" rx="4" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="1.4"/><rect x="2.6" y="2.6" width="21.4" height="8.8" rx="2.6" fill="#fff"/><rect x="27" y="4.6" width="2" height="4.8" rx="1" fill="#fff" fill-opacity=".5"/></svg>
                      </span>
                    </div>
                    <div class="header-row">
                      <span class="back">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
                      </span>
                      <div>
                        <div class="header-eyebrow">Doctor Profile</div>
                        <div class="header-name">Stephen Umana</div>
                      </div>
                    </div>
                  </div>

                  <!-- Body -->
                  <div class="app-body">

                    <div class="card profile-card">
                      <img class="avatar" alt="" src="data:image/jpeg;base64," />
                      <div class="profile-info">
                        <div class="p-name">Stephen Umana</div>
                        <span class="pill">General Practitioner</span>
                        <div class="p-exp">4 years of experience</div>
                      </div>
                    </div>

                    <div class="card about-card">
                      <div class="label">About</div>
                      <p>I am a General Practitioner passionate about providing quality, patient-centred care. I help patients understand their health concerns and make informed decisions about their wellbeing.</p>
                    </div>

                    <div class="card options-card">
                      <div class="label">Consultation Options</div>

                      <div class="option">
                        <span class="radio"></span>
                        <div class="opt-main">
                          <div class="opt-title">Video Consultation</div>
                          <div class="opt-dur">30 min</div>
                          <div class="opt-time">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l3.5 2"/></svg>
                            <span>Mon · 9 AM – 12 PM<br>Wed · 12 PM – 2 PM</span>
                          </div>
                        </div>
                        <div class="opt-price">₦20,000</div>
                      </div>

                      <div class="option">
                        <span class="radio"></span>
                        <div class="opt-main">
                          <div class="opt-title">Voice Consultation</div>
                          <div class="opt-dur">30 min</div>
                          <div class="opt-time">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l3.5 2"/></svg>
                            <span>Mon, Thu · 9 AM – 5 PM</span>
                          </div>
                        </div>
                        <div class="opt-price">₦10,000</div>
                      </div>
                    </div>

                    <div class="cta">
                      Continue to booking
                      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </div>
                  </div>

                  <!-- Tab bar -->
                  <div class="tabbar">
                    <div class="tab">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7.5 9 7.5"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/></svg>
                      <span>Home</span>
                    </div>
                    <div class="tab active">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="7"/><path d="M16 16l5 5"/></svg>
                      <span>Find Care</span>
                    </div>
                    <div class="tab">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 20.5s-8.5-5.2-8.5-11A4.7 4.7 0 0 1 12 6.8a4.7 4.7 0 0 1 8.5 2.7c0 5.8-8.5 11-8.5 11z"/></svg>
                      <span>My Care</span>
                    </div>
                    <div class="tab">
                      <span class="icon-wrap">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H11l-4.5 3.5V16H4z"/></svg>
                        <b class="badge">5</b>
                      </span>
                      <span>Messages</span>
                    </div>
                    <div class="tab">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1-4 4-5.8 7.5-5.8s6.5 1.8 7.5 5.8"/></svg>
                      <span>Profile</span>
                    </div>
                    <div class="home-indicator"></div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <div class="hero-scroll-hint reveal reveal-delay-3">
        <div class="scroll-line"></div>
        Scroll
      </div>
    </section>

    <!-- PREMIUM SPLIT CARDS -->
    <section class="split-section">
      <div class="container split-grid">

        <!-- Patient Card -->
        <a href="/patients" class="split-card patient-theme reveal">
          <div class="card-icon">👤</div>
          <h2>I am a Patient</h2>
          <p>Speak with a doctor online. Explore consultations that fit your schedule, wherever you are.</p>
          <div class="card-action">
            <span>Find a Doctor</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Doctor Card -->
        <a href="/doctors" class="split-card doctor-theme reveal reveal-delay-1">
          <div class="card-icon">🩺</div>
          <h2>I am a Doctor</h2>
          <p>Turn suitable enquiries into paid consultations. Join YerosCare and grow your practice.</p>
          <div class="card-action">
            <span>Apply to Join</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ── HERO BASE ── */
  .hero {
    min-height: 90vh;
    background: var(--purple-deep);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 140px 0 0 0;
  }

  /* Glow Orbs & Grid */
  .hero-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(rgba(167, 139, 250, 0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(167, 139, 250, 0.04) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events: none; z-index: 0;
  }
  .hero-orb { position: absolute; border-radius: 50%; pointer-events: none; z-index: 0; }
  .hero-orb-1 { width: 600px; height: 600px; background: radial-gradient(circle, rgba(167,139,250,0.15) 0%, transparent 70%); top: -100px; right: -150px; }
  .hero-orb-2 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(124,58,237,0.1) 0%, transparent 70%); bottom: -80px; left: -80px; }

  /* ── HERO LAYOUT ── */
  .hero-layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  /* ── HERO TEXT CONTENT ── */
  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 800px;
    padding-bottom: 40px;
  }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--purple-accent); margin-bottom: 28px; padding: 7px 16px;
    border: 1px solid rgba(167, 139, 250, 0.3); border-radius: 100px; background: rgba(167, 139, 250, 0.05);
    backdrop-filter: blur(4px);
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--purple-accent); animation: blink 2s ease-in-out infinite; }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    color: var(--white);
    margin-bottom: 24px;
    line-height: 1.1;
  }
  .hero-title em { font-style: italic; color: var(--purple-accent); }

  .hero-body {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: rgba(255,255,255,0.7);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
    font-weight: 300;
  }

  /* ── HERO IMAGE WRAPPER (Mobile View) ── */
  .hero-image-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: 20px;
    display: flex;
    justify-content: center;
  }

  /* Hide backglow on mobile */
  .image-backglow { display: none; }

  /* ═══════════════════════════════════════════
     PHONE MOCKUP
     Everything is sized in em, so changing
     .phone's font-size scales the whole phone.
     ═══════════════════════════════════════════ */
  .phone {
    --ink: #1a0b2e;
    --violet: #4a2a9a;
    --muted: #5b6190;
    position: relative;
    z-index: 2;
    font-size: 8.6px;               /* mobile size: 30em ≈ 258px wide */
    width: 30em;
    height: 53em;
    flex-shrink: 0;
    font-family: var(--font-body, system-ui, -apple-system, 'Segoe UI', sans-serif);
    /* fade the bottom into the hero, like the old image did */
    -webkit-mask-image: linear-gradient(to top, transparent 0%, black 14%);
    mask-image: linear-gradient(to top, transparent 0%, black 14%);
  }

  .phone, .phone * { box-sizing: border-box; }

  /* Hardware buttons */
  .side-btn { position: absolute; width: 0.28em; background: #8a8f9e; border-radius: 0.2em; }
  .sb-1 { left: -0.2em; top: 9.6em;  height: 2.2em; }
  .sb-2 { left: -0.2em; top: 13.2em; height: 4em; }
  .sb-3 { left: -0.2em; top: 18.2em; height: 4em; }
  .sb-4 { right: -0.2em; top: 14.5em; height: 6.4em; }

  .phone-frame {
    position: absolute; inset: 0;
    border-radius: 5em;
    padding: 0.28em;
    background: linear-gradient(145deg, #e3e6ee 0%, #6e7384 35%, #cfd3dd 60%, #5d6272 100%);
    box-shadow: 0 2em 4em rgba(10, 4, 30, 0.55), 0 0 0 0.1em rgba(255,255,255,0.08);
  }
  .phone-bezel {
    width: 100%; height: 100%;
    border-radius: 4.75em;
    background: #07070b;
    padding: 1.3em;
  }
  .screen {
    position: relative;
    width: 100%; height: 100%;
    border-radius: 3.6em;
    overflow: hidden;
    background: #f7f5fc;
    display: flex; flex-direction: column;
    color: var(--ink);
    text-align: left;
    line-height: 1.3;
  }

  /* Header */
  .app-header {
    position: relative;
    flex: 0 0 auto;
    height: 7.8em;
    background: linear-gradient(160deg, #4a2a9a 0%, #3c2185 100%);
    color: #fff;
    padding: 0 1.4em;
  }
  .island {
    position: absolute; top: 0.9em; left: 50%; transform: translateX(-50%);
    width: 8.2em; height: 2.3em; border-radius: 2em; background: #05050a;
  }
  .status {
    position: relative;
    display: flex; justify-content: space-between; align-items: center;
    height: 3.1em; padding-top: 0.3em;
    font-weight: 600; font-size: 1em;
  }
  .time { margin-left: 0.8em; }
  .status-icons { display: flex; align-items: center; gap: 0.35em; margin-right: 0.3em; }
  .status-icons svg { width: auto; height: 0.85em; }
  .status-icons svg:last-child { height: 0.85em; }

  .header-row { display: flex; align-items: center; gap: 1em; margin-top: 0.3em; }
  .back {
    flex: 0 0 2.9em; height: 2.9em; border-radius: 50%;
    background: rgba(255,255,255,0.14);
    display: flex; align-items: center; justify-content: center;
  }
  .header-eyebrow {
    font-size: 0.72em; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; opacity: 0.92;
  }
  .header-name {
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-size: 2.05em; font-weight: 700; line-height: 1.1;
  }

  /* Body */
  .app-body {
    flex: 1 1 auto;
    padding: 0.6em 0.65em 0;
    display: flex; flex-direction: column; gap: 0.55em;
    min-height: 0;
  }
  .card {
    flex: 0 0 auto;
    background: #fff;
    border-radius: 1.1em;
    box-shadow: 0 0.1em 0.5em rgba(40, 20, 90, 0.06);
  }
  .label {
    font-size: 0.78em; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: #3c4468; margin-bottom: 0.5em;
  }

  .profile-card { display: flex; align-items: center; gap: 1.1em; padding: 0.6em 0.9em; }
  .avatar { width: 5.5em; height: 5.5em; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .p-name { font-weight: 700; font-size: 1.15em; }
  .pill {
    display: inline-block; margin: 0.5em 0 0.45em;
    padding: 0.35em 1em; border-radius: 2em;
    background: #e9e2fb; color: #4a2a9a;
    font-size: 0.78em; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .p-exp { font-size: 0.95em; color: #5a5f86; }

  .about-card { padding: 0.8em 1em 0.7em; }
  .about-card p { margin: 0; font-size: 0.97em; line-height: 1.45; color: #1c1236; }

  .options-card { padding: 0.8em 0.9em 0.7em; }
  .option {
    position: relative;
    display: flex; align-items: flex-start; gap: 0.9em;
    border: 1px solid #dcd8ee; border-radius: 0.9em;
    padding: 0.65em 0.9em 0.65em 0.8em;
    margin-top: 0.5em;
  }
  .radio { flex: 0 0 1.55em; height: 1.55em; border-radius: 50%; border: 1.5px solid #cfcbe3; margin-top: 0.3em; background: #fff; }
  .opt-main { flex: 1; }
  .opt-title { font-weight: 700; font-size: 1.05em; color: #1a0b2e; }
  .opt-dur { font-size: 0.95em; color: #3a3560; margin-top: 0.05em; }
  .opt-time { display: flex; gap: 0.6em; align-items: flex-start; margin-top: 0.55em; color: #5b61a8; font-size: 0.88em; line-height: 1.5; }
  .opt-time svg { flex: 0 0 auto; width: 1.25em; height: 1.25em; margin-top: 0.1em; }
  .opt-price { font-weight: 800; font-size: 1.05em; color: #1a0b2e; white-space: nowrap; }

  .cta {
    flex: 0 0 auto;
    margin-top: auto;
    display: flex; align-items: center; justify-content: center; gap: 0.6em;
    height: 2.55em; border-radius: 1.4em;
    background: #4a2a9a; color: #fff; font-weight: 500; font-size: 1.02em;
  }

  /* Tab bar */
  .tabbar {
    position: relative;
    flex: 0 0 auto;
    height: 4em;
    margin-top: 0.55em;
    display: flex; justify-content: space-around; align-items: flex-start;
    padding: 0.8em 0.3em 0;
    background: #fff;
    border-top: 1px solid #ece9f6;
  }
  .tab { display: flex; flex-direction: column; align-items: center; gap: 0.15em; font-size: 0.72em; color: #2b2750; min-width: 4em; }
  .tab svg { width: 1.9em; height: 1.9em; }
  .tab.active { color: #6d28d9; font-weight: 600; }
  .icon-wrap { position: relative; display: inline-flex; }
  .badge {
    position: absolute; top: -0.5em; right: -0.7em;
    min-width: 1.6em; height: 1.6em; border-radius: 1em;
    background: #ef3b3b; color: #fff; font-size: 0.8em; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .home-indicator {
    position: absolute; bottom: 0.5em; left: 50%; transform: translateX(-50%);
    width: 9em; height: 0.35em; border-radius: 1em; background: #0b0b12;
  }

  /* Scroll Hint */
  .hero-scroll-hint {
    position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: rgba(255,255,255,0.3); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase;
    z-index: 10;
  }
  .scroll-line { width: 1px; height: 40px; background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent); animation: scrollPulse 2s ease-in-out infinite; }
  @keyframes scrollPulse { 0%, 100% { opacity: 0.4; transform: scaleY(1); } 50% { opacity: 1; transform: scaleY(1.2); } }

  /* ── DESKTOP LAYOUT ── */
  @media (min-width: 1024px) {
    .hero {
      padding: 160px 0 0 0;
    }

    .hero-layout {
      flex-direction: row;
      justify-content: flex-start;
      text-align: left;
      align-items: center;
    }

    .hero-content {
      max-width: 55%;
      padding-bottom: 80px;
    }

    .hero-body { margin: 0; }

    /* Image Wrapper */
    .hero-image-wrapper {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 500px;
      max-width: 50vw;
      margin-top: 0;
      display: flex;
      justify-content: center;
    }

    /* Phone scales with viewport height so it never overflows the hero */
    .phone { font-size: min(11.5px, 1.45vh); }

    /* Glow behind the phone */
    .image-backglow {
      display: block;
      position: absolute;
      top: 10%;
      left: -10%;
      width: 120%;
      height: 80%;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.4) 0%, transparent 65%);
      filter: blur(50px);
      z-index: 1;
      pointer-events: none;
    }
  }

  /* ── SPLIT CARDS SECTION ── */
  .split-section { padding: 100px 5vw; background: var(--cream); position: relative; z-index: 2; }
  .split-grid { display: grid; grid-template-columns: 1fr; gap: 32px; max-width: 900px; margin: 0 auto; }

  .split-card {
    display: flex; flex-direction: column; padding: 48px 40px; border-radius: 24px;
    background: var(--white); border: 1px solid rgba(26, 11, 46, 0.08);
    text-decoration: none; color: inherit; transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
  }

  .split-card:hover { transform: translateY(-6px); box-shadow: 0 20px 48px rgba(26, 11, 46, 0.08); border-color: var(--purple-light); }

  .card-icon {
    width: 64px; height: 64px; border-radius: 16px; background: var(--purple-light);
    display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 24px;
  }
  .doctor-theme .card-icon { background: #e0f2fe; }

  .split-card h2 { font-size: 1.8rem; margin-bottom: 12px; color: var(--purple-deep); }
  .split-card p { font-size: 1rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 32px; font-weight: 400; }

  .card-action {
    display: flex; align-items: center; gap: 8px; font-weight: 600; font-family: var(--font-body);
    color: var(--purple-soft); font-size: 1rem; margin-top: auto; transition: gap 0.3s ease;
  }
  .doctor-theme .card-action { color: #0284c7; }
  .split-card:hover .card-action { gap: 16px; }

  @media (min-width: 768px) {
    .split-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
</style>

<script>
  // SCROLL REVEAL ANIMATION
  const revealEls = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => observer.observe(el));
</script>
