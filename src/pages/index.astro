---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="YerosCare - Speak with a Doctor Online" 
  description="Connect with trusted doctors online. Consultations that fit your day, wherever you are."
>
  <!-- We pass audience="home" so neither toggle is highlighted in the header -->
  <Header audience="home" />

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container hero-content">
        <h1 class="hero-title">Healthcare that fits your life.</h1>
        <p class="hero-subtitle">
          YerosCare connects patients with trusted doctors for online consultations, 
          and helps doctors turn enquiries into paid consultations. 
        </p>
      </div>
    </section>

    <!-- The Split / Fork in the Road -->
    <section class="split-section">
      <div class="container split-grid">
        
        <!-- Patient Card -->
        <a href="/patients" class="split-card patient-card">
          <div class="card-image-wrapper">
            <!-- Replace with actual patient image in public/images -->
            <div class="placeholder-image patient-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
          </div>
          <div class="card-content">
            <h2>I am a Patient</h2>
            <p>Speak with a doctor online. Explore consultations that fit your schedule, wherever you are.</p>
            <span class="card-cta">Find a Doctor &rarr;</span>
          </div>
        </a>

        <!-- Doctor Card -->
        <a href="/doctors" class="split-card doctor-card">
          <div class="card-image-wrapper">
            <!-- Replace with actual doctor image in public/images -->
            <div class="placeholder-image doctor-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            </div>
          </div>
          <div class="card-content">
            <h2>I am a Doctor</h2>
            <p>Turn suitable enquiries into consultations. Join YerosCare and connect with patients seeking your expertise.</p>
            <span class="card-cta">Apply to Join &rarr;</span>
          </div>
        </a>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero Section Styles */
  .hero {
    padding: 4rem 0 3rem 0;
    text-align: center;
    background-color: var(--color-bg-light);
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-title {
    font-size: 2.5rem;
    line-height: 1.2;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Split Section Styles */
  .split-section {
    padding: 3rem 0 6rem 0;
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1fr; /* Stack on mobile */
    gap: 2rem;
  }

  /* Card Styles */
  .split-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-white);
    border-radius: 1.5rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 2px solid #E5E7EB;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .split-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-primary-light);
    box-shadow: 0 10px 25px -5px rgba(74, 27, 122, 0.15);
  }

  .card-image-wrapper {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F3F4F6;
  }

  .patient-placeholder {
    background-color: #EDE9FE; /* Light purple */
    color: var(--color-primary);
  }

  .doctor-placeholder {
    background-color: #E0F2FE; /* Light blue/teal for contrast */
    color: #0284C7;
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-content h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-main);
  }

  .card-content p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    flex-grow: 1; /* Pushes the CTA to the bottom */
  }

  .card-cta {
    font-weight: 700;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.1rem;
  }

  .doctor-card .card-cta {
    color: #0284C7; /* Match the doctor theme */
  }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .hero {
      padding: 6rem 0 5rem 0;
    }

    .hero-title {
      font-size: 3.5rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .split-grid {
      grid-template-columns: 1fr 1fr; /* Side by side on desktop */
      gap: 3rem;
    }

    .card-image-wrapper {
      height: 250px; /* Taller images on desktop */
    }
  }
</style>
