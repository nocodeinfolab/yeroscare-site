---
import Layout from '../layouts/Layout.astro';
import QRCode from 'qrcode';

const stores = [
  { href: __APPSTORE_URL__, line: 'Download on the', name: 'App Store' },
  { href: __PLAY_URL__, line: 'Get it on', name: 'Google Play' },
];

// QR code that points back to this page, so a desktop visitor can scan it with their phone
const qr = await QRCode.toString(new URL('/get', Astro.site).href, {
  type: 'svg',
  margin: 0,
  color: { dark: '#2a0f66', light: '#ffffff' },
});
---

<Layout
  title="Get the YerosCare app"
  description="Download YerosCare for iPhone or Android."
  sticky={false}
  redirect={true}
  noindex={true}
>
  <div class="wrap get">
    <div>
      <h1>Get the YerosCare app</h1>
      <p class="lede">
        Download the app, sign in with your email and get started. If you followed a doctor's link,
        install the app, then open the link again.
      </p>
      <div class="stores">
        {
          stores.map((s) => (
            <a class="store" href={s.href}>
              <span>{s.line}</span>
              <strong>{s.name}</strong>
            </a>
          ))
        }
      </div>
    </div>
    <div class="qr-wrap">
      <div class="qr" role="img" aria-label="QR code for this page. Scan it with your phone to download the app." set:html={qr} />
      <p class="small qr-note">Scan with your phone</p>
    </div>
  </div>
</Layout>
