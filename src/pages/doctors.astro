---
import Layout from '../layouts/Layout.astro';

const stores = [
  { href: __APPSTORE_URL__, line: 'Download on the', name: 'App Store' },
  { href: __PLAY_URL__, line: 'Get it on', name: 'Google Play' },
];
const SUPPORT_EMAIL = __SUPPORT_EMAIL__;
const LEGAL_URL = __LEGAL_URL__;
---

<Layout
  title="YerosCare for doctors: turn suitable enquiries into booked consultations"
  description="Share your YerosCare link, set your own hours and prices, and get paid automatically 24 hours after each consultation. Start with 30 days free on the Starter plan."
  page="doctors"
  ctaLabel="Join as a doctor"
>
  <!-- ═════ AWARENESS: why does this matter to me? ═════ -->

  <section class="hero hero-dark on-dark">
    <div class="wrap hero-grid">
      <div>
        <h1>Turn suitable enquiries into booked consultations.</h1>
        <p class="lede">
          Share your YerosCare link so people can see your services, fees and available times before
          they book. You set your own hours and your own prices.
        </p>
        <div class="hero-actions">
          <div class="stores">
            {
              stores.map((s) => (
                <a class="store" href={s.href}>
                  <span>{s.line}</span>
                  <strong>{s.name}</strong>
                </a>
              ))
            }
          </div>
          <a class="btn btn-outline" href="#plans">See the plans</a>
        </div>
        <p class="hero-note"><b>30 days free</b> on the Starter plan.</p>
      </div>

      <!--
        This phone is an illustration. When you have a real screenshot, save it as
        public/phone-doctor.webp and replace the whole <div class="phone-wrap"> block with:
        <img src="/phone-doctor.webp" alt="..." width="560" height="1100" />
      -->
      <div class="phone-wrap">
        <div class="phone" role="img" aria-label="Illustration of a doctor's shareable YerosCare link, services and working days">
          <div class="phone-screen" aria-hidden="true">
            <p class="phone-label">Your YerosCare link</p>
            <div class="link-box"><span>yeroscare.com/d/your-name</span><span>Copy</span></div>
            <p class="phone-label">Services you offer</p>
            <ul class="chips">
              <li class="chip">Video</li>
              <li class="chip">Voice</li>
              <li class="chip">Chat</li>
              <li class="chip">Home service</li>
            </ul>
            <p class="phone-label">Working days</p>
            <ul class="chips">
              <li class="slot">Mon</li>
              <li class="slot">Wed</li>
              <li class="slot">Fri</li>
            </ul>
            <span class="skel"></span>
            <span class="skel" style="width: 65%"></span>
          </div>
        </div>
        <p class="caption">Illustrative screen</p>
      </div>
    </div>
  </section>

  <div class="wrap benefits">
    <div class="benefit">
      <h3>Your hours</h3>
      <p>Choose your working days and hours. Patients see them as your availability.</p>
    </div>
    <div class="benefit">
      <h3>Your prices</h3>
      <p>Set your own fee for each service you offer: video, voice, chat or home service.</p>
    </div>
    <div class="benefit">
      <h3>A verified listing</h3>
      <p>We verify your MDCN licence before patients can see your profile.</p>
    </div>
    <div class="benefit">
      <h3>Automatic payouts</h3>
      <p>You are paid 24 hours after each completed consultation.</p>
    </div>
  </div>

  <!-- ═════ CONSIDERATION: would this work for me? ═════ -->

  <section class="section section-tint" id="link">
    <div class="wrap split">
      <div>
        <h2>Getting consultation requests in your messages? Give them a clear next step.</h2>
      </div>
      <div>
        <p>
          Paste your YerosCare link into a reply or your profile. People can see your services,
          fees and available times, then book and pay in the app. If they do not have the app yet,
          the link sends them to the store.
        </p>
        <p>
          YerosCare does not read your WhatsApp, Facebook, Instagram or X messages. You share your
          link yourself, wherever people are already asking.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="wrap split">
      <div>
        <h2>How it works</h2>
        <p>From sign-up to payout, everything happens in the app.</p>
      </div>
      <ol class="steps">
        <li>
          <div>
            <h3>Sign in with your email</h3>
            <p>Download YerosCare and use your email address to get started.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Add your professional details</h3>
            <p>Give us your professional information and your MDCN licence number.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>We verify your licence</h3>
            <p>You can see your verification status in the app. Patients see your profile once you are verified.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Set your services, prices and hours</h3>
            <p>Choose what you offer, what you charge for each service, and the days and hours you work.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Share your link and consult</h3>
            <p>Patients book and pay in the app. You consult, and your payout follows automatically.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-tint" id="plans">
    <div class="wrap">
      <div class="section-head">
        <h2>Plans and commission</h2>
        <p>
          The three plans differ only in the monthly fee and the commission on each consultation.
          Every plan has the same features.
        </p>
      </div>

      <p class="trial">30 days free on the Starter plan. Commission still applies to each consultation.</p>

      <div class="table-wrap">
        <table class="plans">
          <thead>
            <tr>
              <th scope="col">Plan</th>
              <th scope="col">Monthly fee</th>
              <th scope="col">Commission on each consultation</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Starter</th>
              <td><strong>₦5,000</strong></td>
              <td><strong>5%</strong></td>
            </tr>
            <tr>
              <th scope="row">Professional</th>
              <td><strong>₦10,000</strong></td>
              <td><strong>3%</strong></td>
            </tr>
            <tr>
              <th scope="row">Premium</th>
              <td><strong>₦20,000</strong></td>
              <td><strong>1%</strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 style="margin-top: 2.5rem">Which plan costs you least?</h3>
      <ul class="ticks">
        <li>If patients pay you less than ₦250,000 a month in consultation fees, Starter costs you least.</li>
        <li>Between ₦250,000 and ₦500,000 a month, Professional costs you least.</li>
        <li>Above ₦500,000 a month, Premium costs you least.</li>
      </ul>
      <p class="small" style="margin-top: 1rem">
        For example, on a ₦20,000 consultation the commission is ₦1,000 on Starter, ₦600 on
        Professional and ₦200 on Premium. This is a guide to what you pay us, not a promise of what
        you will earn.
      </p>
    </div>
  </section>

  <section class="section" id="payouts">
    <div class="wrap split">
      <div>
        <h2>Paid automatically, 24 hours after each consultation</h2>
      </div>
      <div>
        <p class="equation">
          <span>What the patient paid</span>
          <i>minus</i>
          <span>your plan's commission</span>
          <i>equals</i>
          <span>what you receive</span>
        </p>
        <p>
          Your payout arrives 24 hours after the consultation is completed. Doctors pay no payment
          processing charges.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="responsibilities">
    <div class="wrap">
      <div class="section-head">
        <h2>Who does what</h2>
      </div>
      <div class="cols">
        <div>
          <h3>You are responsible for</h3>
          <ul class="ticks">
            <li>The clinical advice you give.</li>
            <li>Keeping your profile, services and availability accurate.</li>
            <li>
              Responding within 48 hours when a patient asks to cancel a paid consultation. If you do
              not respond, the patient's refund goes ahead.
            </li>
          </ul>
        </div>
        <div>
          <h3>YerosCare handles</h3>
          <ul class="ticks">
            <li>Verifying your MDCN licence before patients see your profile.</li>
            <li>Taking payment from patients in the app.</li>
            <li>Paying you automatically, 24 hours after each completed consultation.</li>
            <li>
              Support: email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
            </li>
          </ul>
        </div>
      </div>
      <p class="small" style="margin-top: 2rem">
        The full terms are at <a href={LEGAL_URL}>{LEGAL_URL.replace('https://', '')}</a>.
      </p>
    </div>
  </section>

  <!-- ═════ DECISION: what happens next? ═════ -->

  <section class="section" id="join">
    <div class="wrap split">
      <div>
        <h2>What you need to join</h2>
      </div>
      <div>
        <ul class="ticks" style="margin-top: 0">
          <li>An email address to sign in with.</li>
          <li>Your professional details.</li>
          <li>Your MDCN licence number.</li>
        </ul>
        <p style="margin-top: 1.5rem">
          After you submit your details, we verify your licence. You can check your status in the
          app, and patients can see your profile once you are verified.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-tint" id="faq">
    <div class="wrap split">
      <div>
        <h2>Questions doctors ask</h2>
      </div>
      <div class="faq">
        <details>
          <summary>Is there a free trial?</summary>
          <p>
            Yes. You get 30 days free on the Starter plan. Commission still applies to every
            consultation during the trial.
          </p>
        </details>
        <details>
          <summary>Who sets my prices?</summary>
          <p>
            You do. Set a fee for each service you offer. Patients see your fees before they book.
          </p>
        </details>
        <details>
          <summary>Can I choose my own working hours?</summary>
          <p>
            Yes. You pick your working days and hours, and patients see them as your availability.
          </p>
        </details>
        <details>
          <summary>When do I get paid?</summary>
          <p>
            Automatically, 24 hours after a consultation is completed. You receive what the patient
            paid minus your plan's commission.
          </p>
        </details>
        <details>
          <summary>Are there payment processing charges?</summary>
          <p>No. Doctors pay no payment processing charges.</p>
        </details>
        <details>
          <summary>What happens if a patient cancels?</summary>
          <p>
            A patient can request cancellation of a paid service that has not taken place. We tell
            you, and you are expected to respond within 48 hours. If you do not respond, the refund
            goes ahead.
          </p>
        </details>
        <details>
          <summary>How do I know when I am verified?</summary>
          <p>You can see your verification status in the app.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section section-dark on-dark" id="get">
    <div class="wrap">
      <h2>Ready to offer consultations?</h2>
      <p class="lede">
        Download YerosCare, sign in with your email and add your details. Your first 30 days on the
        Starter plan are free.
      </p>
      <div class="stores">
        {
          stores.map((s) => (
            <a class="store" href={s.href}>
              <span>{s.line}</span>
              <strong>{s.name}</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
