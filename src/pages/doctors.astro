---
// src/pages/doctors.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AppCTA from '../components/AppCTA.astro';
---

<Layout 
  title="YerosCare for Doctors - Turn Enquiries into Consultations" 
  description="Stop chasing DMs. Share your YerosCare link so patients can view your details and book paid consultations. Flexible hours, automatic payouts."
>
  <Header audience="doctors" />

  <main>
    <!-- STAGE 1: AWARENESS (Why should I care?) -->
    <section class="stage-section stage-awareness">
      <div class="container split-layout">
        <div class="content-left">
          <span class="stage-badge">For Medical Professionals</span>
          <h1>Turn suitable enquiries into paid consultations.</h1>
          <p class="lead-text">
            Receiving consultation requests in your WhatsApp, Instagram, or Facebook messages? 
            Give suitable enquiries a clear, professional next step.
          </p>
          <p>
            Join YerosCare and connect with patients seeking your expertise. Share your unique booking link so patients can view your consultation details and available appointments before booking.
          </p>
          <div class="cta-group">
            <AppCTA text="Apply to Join" class="btn-large" />
          </div>
        </div>
        <div class="visual-right">
          <!-- Placeholder for Doctor Image -->
          <div class="visual-placeholder">
            <p>Doctor Image or App Workflow Mockup</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STAGE 2: CONSIDERATION (Is this right for me?) -->
    <section class="stage-section stage-workflow">
      <div class="container">
        <div class="section-header">
          <h2>See the consultation workflow</h2>
          <p>From patient enquiry to completed consultation, everything is handled in one place.</p>
        </div>

        <div class="workflow-grid">
          <div class="workflow-step">
            <div class="step-number">1</div>
            <h3>Share your link</h3>
            <p>Share your YerosCare profile with patients on social media or via direct message.</p>
          </div>
          <div class="workflow-step">
            <div class="step-number">2</div>
            <h3>Patient books</h3>
            <p>Patients view your services, fees, and available hours, then book and pay directly in the app.</p>
          </div>
          <div class="workflow-step">
            <div class="step-number">3</div>
            <h3>Consultation</h3>
            <p>Consult via video, voice, or chat on our secure platform. Offer home visits if you choose.</p>
          </div>
          <div class="workflow-step">
            <div class="step-number">4</div>
            <h3>Automatic Payout</h3>
            <p>Receive your payout automatically 24 hours after the consultation is completed.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STAGE 2.5: Built for your practice (Flexibility & Trust) -->
    <section class="stage-section stage-benefits">
      <div class="container split-layout reverse">
        <div class="visual-left">
          <div class="visual-placeholder bg-purple-light">
            <p>App Screen: Setting Availability & MDCN Status</p>
          </div>
        </div>
        <div class="content-right">
          <h2>Built for your practice.</h2>
          <ul class="benefit-list">
            <li>
              <strong>Total flexibility:</strong> Set your own working days and hours. Patients only see the availability you choose.
            </li>
            <li>
              <strong>Verified trust:</strong> Provide your MDCN license number during onboarding. Once verified, your profile is visible to patients, giving them confidence in your expertise.
            </li>
            <li>
              <strong>Home service controls:</strong> If you offer home visits, you define the specific areas you cover, and patients see this before booking.
            </li>
            <li>
              <strong>Zero processor fees:</strong> Your payout is simply the amount the patient paid, minus the platform commission. We handle the payment processing costs.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- STAGE 3: DECISION (How do I get started?) -->
    <section class="stage-section stage-pricing">
      <div class="container">
        <div class="section-header">
          <h2>Simple, transparent plans</h2>
          <p>Start with a <strong>30-day free trial</strong> (Starter tier). Commission still applies during the trial.</p>
        </div>

        <div class="pricing-grid">
          
          <!-- Starter Plan -->
          <div class="pricing-card">
            <h3>Starter</h3>
            <div class="price">₦5,000<span>/month</span></div>
            <p class="commission">5% platform commission per consultation</p>
            <ul class="pricing-features">
              <li>✓ Shareable booking link</li>
              <li>✓ Video, voice & chat</li>
              <li>✓ Automatic payouts</li>
              <li>✓ 30-day free trial</li>
            </ul>
            <AppCTA text="Start Free Trial" variant="outline" class="w-full" />
          </div>

          <!-- Professional Plan -->
          <div class="pricing-card featured">
            <div class="featured-badge">Most Popular</div>
            <h3>Professional</h3>
            <div class="price">₦10,000<span>/month</span></div>
            <p class="commission">3% platform commission per consultation</p>
            <ul class="pricing-features">
              <li>✓ Everything in Starter</li>
              <li>✓ Lower commission rate</li>
              <li>✓ Priority support</li>
            </ul>
            <AppCTA text="Apply to Join" class="w-full" />
          </div>

          <!-- Premium Plan -->
          <div class="pricing-card">
            <h3>Premium</h3>
            <div class="price">₦20,000<span>/month</span></div>
            <p class="commission">1% platform commission per consultation</p>
            <ul class="pricing-features">
              <li>✓ Everything in Professional</li>
              <li>✓ Lowest commission rate</li>
              <li>✓ Ideal for high-volume practices</li>
            </ul>
            <AppCTA text="Apply to Join" variant="outline" class="w-full" />
          </div>

        </div>
      </div>
    </section>

    <!-- Final Onboarding Call to Action -->
    <section class="stage-section stage-onboarding">
      <div class="container text-center-container">
        <h2>Ready to offer consultations?</h2>
        <p class="lead-text">
          Complete a simple onboarding process. Download the app, log in with your email, and provide your professional information and MDCN license number. 
        </p>
        
        <div class="cta-group center-cta">
          <AppCTA text="Download App to Apply" class="btn-large" />
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Inheriting many styles from patients.astro, but adjusting for the Doctor theme */
  .stage-section {
    padding: 5rem 0;
  }

  .stage-awareness { background-color: var(--color-bg-light); padding-top: 4rem; }
  .stage-workflow { background-color: var(--color-bg-white); }
  .stage-benefits { background-color: #F3F0F9; }
  .stage-pricing { background-color: var(--color-bg-light); }
  .stage-onboarding { background-color: var(--color-primary-dark); color: white; }

  h1, h2, h3 { color: var(--color-primary-dark); }
  .stage-onboarding h2 { color: white; }
  
  h1 { font-size: 2.5rem; line-height: 1.2; margin-bottom: 1rem; font-weight: 800; }
  h2 { font-size: 2rem; line-height: 1.3; margin-bottom: 1rem; }
  h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }

  .lead-text { font-size: 1.25rem; color: var(--color-text-muted); margin-bottom: 1.5rem; line-height: 1.6; }
  .stage-onboarding .lead-text { color: #E9D5FF; }

  .stage-badge {
    display: inline-block;
    background-color: #E9D5FF;
    color: var(--color-primary-dark);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  /* Layouts */
  .split-layout { display: flex; flex-direction: column; gap: 3rem; align-items: center; }
  .content-left, .content-right { flex: 1; }
  .visual-right, .visual-left { flex: 1; width: 100%; }

  .visual-placeholder {
    width: 100%; height: 350px; background-color: #E5E7EB; border-radius: 1.5rem;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-text-muted); border: 2px dashed #D1D5DB;
  }
  .bg-purple-light { background-color: #EDE9FE; border-color: #C4B5FD; }

  /* Workflow Grid */
  .section-header { text-align: center; max-width: 600px; margin: 0 auto 3rem auto; }
  
  .workflow-grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  
  .workflow-step {
    background-color: var(--color-bg-light); padding: 2rem; border-radius: 1rem;
    border: 1px solid #E5E7EB; position: relative;
  }

  .step-number {
    width: 40px; height: 40px; background-color: var(--color-primary); color: white;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-weight: bold; font-size: 1.25rem; margin-bottom: 1rem;
  }

  .workflow-step p { color: var(--color-text-muted); font-size: 0.95rem; }

  /* Benefit List */
  .benefit-list { list-style: none; padding: 0; margin-top: 1.5rem; }
  .benefit-list li {
    position: relative; padding-left: 2rem; margin-bottom: 1.25rem; color: var(--color-text-muted);
  }
  .benefit-list li::before {
    content: "✓"; position: absolute; left: 0; color: var(--color-primary);
    font-weight: bold; font-size: 1.2rem;
  }

  /* Pricing Grid */
  .pricing-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2rem; }
  
  .pricing-card {
    background-color: white; padding: 2.5rem 2rem; border-radius: 1.5rem;
    border: 2px solid #E5E7EB; display: flex; flex-direction: column;
    position: relative; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .pricing-card.featured {
    border-color: var(--color-primary);
    box-shadow: 0 10px 25px -5px rgba(74, 27, 122, 0.15);
  }

  .featured-badge {
    position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
    background-color: var(--color-primary); color: white; padding: 0.25rem 1rem;
    border-radius: 9999px; font-size: 0.875rem; font-weight: 600;
  }

  .price { font-size: 2.5rem; font-weight: 800; color: var(--color-primary-dark); margin: 1rem 0 0.5rem 0; }
  .price span { font-size: 1rem; font-weight: 500; color: var(--color-text-muted); }
  
  .commission {
    background-color: #F3F0F9; padding: 0.5rem; border-radius: 0.5rem;
    font-weight: 600; font-size: 0.9rem; color: var(--color-primary-dark); margin-bottom: 1.5rem;
  }

  .pricing-features { list-style: none; padding: 0; margin-bottom: 2rem; flex-grow: 1; }
  .pricing-features li { margin-bottom: 0.75rem; color: var(--color-text-muted); font-size: 0.95rem; }

  /* CTA */
  .cta-group { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; }
  .center-cta { align-items: center; }
  .btn-large { padding: 1rem 2rem; font-size: 1.1rem; width: 100%; max-width: 300px; }
  .w-full { width: 100%; text-align: center; display: block; }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .split-layout { flex-direction: row; gap: 4rem; }
    .split-layout.reverse { flex-direction: row-reverse; }
    
    .workflow-grid { grid-template-columns: 1fr 1fr; } /* 2x2 */
    .pricing-grid { grid-template-columns: 1fr 1fr 1fr; } /* 3 columns */
    
    .center-cta { justify-content: center; }
    
    h1 { font-size: 3.5rem; }
    h2 { font-size: 2.5rem; }
    .visual-placeholder { height: 450px; }
  }
</style>
